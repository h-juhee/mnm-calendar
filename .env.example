# App entry mode. Use `internal` for staff and `customer` for the director-facing deployment.
VITE_APP_MODE=internal

# Notion integration secret. Never prefix this value with VITE_.
NOTION_TOKEN=ntn_your_integration_secret

# Recommended: copy the 32-character ID from the copied Notion database page URL.
# The server automatically finds the database's first data source.
NOTION_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Calendar download usage history data source. Keep this server-side only.
NOTION_USAGE_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: client database containing the `진료시간` property.
# When omitted, the server follows the `거래처` relation in the usage database.
# NOTION_CLIENT_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_CLIENT_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
